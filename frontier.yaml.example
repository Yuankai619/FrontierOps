schema_version: "0.1"
project:
  id: adsl-frontier-demo
  name: ADSL Research Frontier Briefing
  timezone: Asia/Taipei
  language: zh-TW
  workspace_dir: .frontier
profile:
  topics:
    - id: research-communication
      description: automatic scientific paper explanation presentation slide and video generation
      weight: 1.0
  keywords:
    include: [academic presentation, research paper, video generation, research agent]
    exclude: []
tracking:
  scholars:
    - id: fixture-ada
      name: Ada Researcher
      aliases: [A. Researcher]
      identities: {semantic_scholar: fixture-author-1001}
      providers: [semantic_scholar]
      backfill_days: 365
      always_include_new_publications: true
  venues:
    - provider: openreview
      venue_id: ICLR.cc/2026/Conference
      decisions: [Accept, "Accept (Oral)"]
sources:
  semantic_scholar:
    enabled: false
    mode: live
    base_url: https://api.semanticscholar.org/graph/v1
    api_key_env: SEMANTIC_SCHOLAR_API_KEY
    page_size: 100
    max_results: 100
    request_delay_seconds: 3
  arxiv:
    enabled: true
    mode: fixture
    fixture_path: data/fixtures/arxiv-papers.json
    overlap_days: 3
    base_url: https://export.arxiv.org/api/query
    paper_ids: ["2510.05096"]
    page_size: 100
    max_results: 100
    request_delay_seconds: 3
  local_library:
    enabled: false
    roots: [data/library]
    recursive: true
    allowed_extensions: [.pdf, .md, .txt]
    allow_outside_project_root: false
  openreview:
    enabled: true
    mode: fixture
    fixture_path: data/fixtures/openreview-notes.json
    base_url: https://api2.openreview.net
    username_env: OPENREVIEW_USERNAME
    password_env: OPENREVIEW_PASSWORD
    token_env: OPENREVIEW_TOKEN
    include_replies: true
sync:
  trigger_mode: manual
  baseline: last_successful_sync
  default_lookback_days: 14
ranking:
  gates:
    - {id: publication-window, type: publication_year, min_year: 2024, on_fail: exclude}
    - {id: citation-policy, type: citation, minimum_count: 3, exempt_if_age_days_lte: 90, on_fail: exclude}
    - {id: relevance-floor, type: relevance, minimum: 0.05, on_fail: exclude}
  features:
    lexical_relevance: {enabled: true, weight: 0.55}
    citation: {enabled: true, weight: 0.15}
    freshness: {enabled: true, weight: 0.15}
    reliability: {enabled: true, weight: 0.15}
  citation_scale: 100
  freshness_half_life_days: 180
  source_reliability: {arxiv: 0.8, semantic_scholar: 0.8, openreview: 0.9, local_library: 1.0}
  deep_enrich_top_k: 5
  max_fulltext_pages: 20
brief:
  target_duration_seconds: 300
  maximum_developments: 5
  maximum_seconds_per_development: 75
  narration_words_per_minute: 140
  outputs: [html, slides, video]
review:
  required: true
  fail_on_missing_evidence: true
  fail_on_broken_source: true
  fail_on_unsupported_number: true
  fail_on_duration_over_budget: true
  fail_on_duplicate_development: true
  auto_fix: safe_only
