schema_version: "0.1"
project:
  id: adsl-frontier-demo
  name: ADSL Research Frontier Briefing
  timezone: Asia/Taipei
  language: zh-TW
  workspace_dir: .frontier
tracking:
  scholars:
    - id: fixture-ada
      name: Ada Researcher
      aliases: [A. Researcher]
      identities: {semantic_scholar: fixture-author-1001}
      providers: [semantic_scholar]
      backfill_days: 365
      always_include_new_publications: true
  venues:
    - provider: openreview
      venue_id: ICLR.cc/2026/Conference
      decisions: [Accept, "Accept (Oral)"]
sources:
  semantic_scholar:
    enabled: false
    mode: live
    base_url: https://api.semanticscholar.org/graph/v1
    api_key_env: SEMANTIC_SCHOLAR_API_KEY
    page_size: 100
    max_results: 100
    request_delay_seconds: 3
  arxiv:
    enabled: true
    mode: fixture
    fixture_path: data/fixtures/arxiv-papers.json
    overlap_days: 3
    base_url: https://export.arxiv.org/api/query
    paper_ids: ["2510.05096"]
    page_size: 100
    max_results: 100
    request_delay_seconds: 3
sync:
  trigger_mode: manual
  baseline: last_successful_sync
  default_lookback_days: 14
brief:
  target_duration_seconds: 300
  maximum_developments: 5
  outputs: [html, slides, video]
